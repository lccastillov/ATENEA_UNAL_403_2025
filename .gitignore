# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
dist/
build/

# ============================================================
# JUPYTER
# ============================================================
.ipynb_checkpoints/

# ============================================================
# ENVIRONMENTS
# ============================================================
.env
.venv/
venv/
env/
ENV/
conda-meta/

# ============================================================
# OS / EDITORS
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ============================================================
# LOGS / TEMPORARY FILES
# ============================================================
*.log
*.tmp
*.temp
*.bak
~$*
*.lock

# ============================================================
# LARGE RAW RASTER FILES
# ============================================================
# Raw raster inputs exported from Google Earth Engine or generated externally
# can be very large. These should generally be stored outside Git.
data/raw/**/*.tif
data/raw/**/*.tiff
data/raw/**/*.TIF
data/raw/**/*.TIFF
data/raw/**/*.vrt
data/raw/**/*.VRT
data/raw/**/*.ovr
data/raw/**/*.OVR
data/raw/**/*.aux.xml

# ============================================================
# FINAL RASTER OUTPUTS
# ============================================================
# Final raster outputs can usually be regenerated by running the notebooks.
outputs/rasters/**/*.tif
outputs/rasters/**/*.tiff
outputs/rasters/**/*.TIF
outputs/rasters/**/*.TIFF
outputs/rasters/**/*.vrt
outputs/rasters/**/*.VRT
outputs/rasters/**/*.ovr
outputs/rasters/**/*.OVR
outputs/rasters/**/*.aux.xml

# ============================================================
# AUXILIARY RASTER FILES
# ============================================================
# Auxiliary raster sidecar files are ignored even when intermediate rasters
# are versioned.
*.aux.xml
*.ovr
*.OVR

# ============================================================
# INTERMEDIATE RASTERS
# ============================================================
# Intermediate rasters are NOT ignored by default in this version.
# This allows versioning files such as:
#
# data/interim/clasificacion_coberturas/RPR_2018/*.tif
# data/interim/clasificacion_coberturas/MBR_2018/*.tif
# data/interim/clasificacion_coberturas/reducidos/*.tif
#
# If these files become too large or change frequently, uncomment:
#
# data/interim/**/*.tif
# data/interim/**/*.tiff
# data/interim/**/*.TIF
# data/interim/**/*.TIFF
# data/interim/**/*.vrt
# data/interim/**/*.VRT

# ============================================================
# OPTIONAL LARGE MODEL FILES
# ============================================================
# Keep models versionable by default.
# Uncomment these lines if trained models become too large
# or if models should be regenerated instead of versioned.
#
# models/**/*.joblib
# data/interim/**/*.joblib

# ============================================================
# OPTIONAL LARGE GEOSPATIAL VECTOR FILES
# ============================================================
# Keep vector inputs versionable by default.
# Uncomment if GeoPackages or shapefiles are too large
# or should be managed outside Git.
#
# *.gpkg
# *.shp
# *.shx
# *.dbf
# *.prj
# *.cpg

# ============================================================
# KEEP SMALL RESULTS VERSIONABLE
# ============================================================
# CSV, PNG, Markdown, notebooks and Python scripts are intentionally
# not ignored by default because they document results and workflow.
